{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nash AI Functions Workflow API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Workflow",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Workflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.usenash.com/v1/workflows"
          },
          "docs": "Returns all non-archived workflows for the authenticated organization."
        },
        {
          "info": {
            "name": "Create Workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.usenash.com/v1/workflows",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new workflow with nodes, edges, and a trigger. The workflow is created in draft status by default. Nodes define the actions and filters, edges define the execution flow between nodes, and the trigger defines when the workflow is activated."
        },
        {
          "info": {
            "name": "Get Workflow Schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.usenash.com/v1/workflows/schema"
          },
          "docs": "Returns self-describing workflow metadata including triggers, action config schemas, filter operators/fields, and supported workflow node, edge, and status types."
        },
        {
          "info": {
            "name": "Get Workflow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.usenash.com/v1/workflows/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a single workflow by ID, including its latest version with nodes, edges, and trigger."
        },
        {
          "info": {
            "name": "Update Workflow",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.sandbox.usenash.com/v1/workflows/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing workflow. Only provided fields are updated. If nodes, edges, and trigger are all provided, a new workflow version is created. These three structure fields must be provided together or not at all."
        },
        {
          "info": {
            "name": "Set Workflow Status",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.usenash.com/v1/workflows/:id/status",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Change the status of a workflow (draft, active, inactive, archived, template). Archiving a workflow disables its notification trigger."
        },
        {
          "info": {
            "name": "Trigger Workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.usenash.com/v1/workflows/:id/trigger",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Trigger an active workflow with optional entity references and input data. Supports sync and async execution modes."
        }
      ]
    }
  ],
  "bundled": true
}