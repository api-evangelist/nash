        {
          "id": "44d5f3c7-ef98-42d3-9333-44254283461d",
          "name": "List Webhook Messages",
          "request": {
            "name": "List Webhook Messages",
            "description": {
              "content": "Inspect webhooks sent to this organization's configured endpoints via Svix. Primarily intended for debugging 'did the customer receive our webhook?' questions. Every outbound webhook is tagged with the relevant entity IDs (e.g. `jb_abc123`, `dlv_xyz789`), so pass the Nash ID as `tag` to find all webhooks about that entity. Returns an empty result if the organization has no Svix app configured.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "webhooks",
                "messages"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "tag",
                  "value": "<string>",
                  "description": "Filter messages by tag. Nash stamps entity IDs as tags on every outbound webhook, so pass the prefixed Nash ID directly — e.g. `jb_abc123` to find every webhook about a job, `dlv_xyz789` for a delivery."
                },
                {
                  "disabled": false,
                  "key": "eventTypes",
                  "value": "<string>",
                  "description": "Comma-separated Svix event types (e.g. delivery.status_updated)"
                },
                {
                  "disabled": false,
                  "key": "channel",
                  "value": "<string>",
                  "description": "Filter by Svix channel"
                },
                {
                  "disabled": false,
                  "key": "before",
                  "value": "<dateTime>",
                  "description": "Return messages sent before this timestamp"
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<dateTime>",
                  "description": "Return messages sent after this timestamp"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50"
                },
                {
                  "disabled": false,
                  "key": "iterator",
                  "value": "<string>",
                  "description": "Svix pagination cursor — pass the `iterator` from a previous response to fetch the next page"
                },
                {
                  "disabled": false,
                  "key": "withContent",
                  "value": "true",
                  "description": "Include the message payload in the response. Defaults to true for debugging."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
